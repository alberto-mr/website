---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <section class="blog-post-section">
    <div class="container">
      <article class="blog-post">
        <header class="blog-header">
          <h1 class="blog-title">{post.data.title}</h1>
          <div class="blog-meta">
            <span class="publish-date">
              Published on {post.data.date.toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </span>
          </div>
        </header>
        <div class="blog-content">
          <Content />
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  // Generic PDF Viewer script - initializes all PDF viewers on the page
  (function() {
    var viewerConfigs = [
      { uniqueId: 'ecat', pdfPath: '/assets/pdfs/ECAT-presentation.pdf' },
      { uniqueId: 'chi2026', pdfPath: '/assets/pdfs/CHI-2026-digital-attention-heuristics.pdf' }
    ];

    function initAllPDFViewers() {
      viewerConfigs.forEach(function(config) {
        var container = document.getElementById('pdf-viewer-container-' + config.uniqueId);
        if (container) {
          initSingleViewer(config.uniqueId, config.pdfPath, container);
        }
      });
    }

    function loadPdfJs(callback) {
      if (typeof pdfjsLib !== 'undefined') {
        callback();
      } else {
        var script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = callback;
        document.head.appendChild(script);
      }
    }

    function initSingleViewer(uniqueId, pdfPath, container) {
      loadPdfJs(function() {
        if (typeof pdfjsLib !== 'undefined') {
          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        var canvas = document.getElementById('pdf-canvas-' + uniqueId);
        if (!canvas) return;

        var ctx = canvas.getContext('2d');
        var prevBtn = document.getElementById('prev-btn-' + uniqueId);
        var nextBtn = document.getElementById('next-btn-' + uniqueId);
        var pageInfo = document.getElementById('page-info-' + uniqueId);

        var pdfDoc = null;
        var pageNum = 1;
        var pageRendering = false;
        var pageNumPending = null;

        function getScale() {
          var containerWidth = container.offsetWidth;
          if (containerWidth < 480) return 0.8;
          if (containerWidth < 768) return 1.0;
          return 1.5;
        }

        function renderPage(num) {
          pageRendering = true;
          pdfDoc.getPage(num).then(function(page) {
            var canvasContainer = container.querySelector('.pdf-canvas-container');
            if (!canvasContainer) return;

            var style = window.getComputedStyle(canvasContainer);
            var padLeft = parseFloat(style.paddingLeft) || 0;
            var padRight = parseFloat(style.paddingRight) || 0;
            var availableWidth = canvasContainer.offsetWidth - padLeft - padRight;

            var baseViewport = page.getViewport({scale: 1});
            var maxWidth = availableWidth * 0.98;
            var calculatedScale = maxWidth / baseViewport.width;
            var finalScale = Math.min(calculatedScale, getScale());

            var finalViewport = page.getViewport({scale: finalScale});
            canvas.height = finalViewport.height;
            canvas.width = finalViewport.width;

            page.render({ canvasContext: ctx, viewport: finalViewport }).promise.then(function() {
              pageRendering = false;
              if (pageNumPending !== null) {
                renderPage(pageNumPending);
                pageNumPending = null;
              }
            });
          });

          pageInfo.textContent = 'Slide ' + num + ' of ' + pdfDoc.numPages;
          prevBtn.disabled = num <= 1;
          nextBtn.disabled = num >= pdfDoc.numPages;
        }

        function queueRenderPage(num) {
          if (pageRendering) { pageNumPending = num; } else { renderPage(num); }
        }

        function onPrevPage() { if (pageNum > 1) { pageNum--; queueRenderPage(pageNum); } }
        function onNextPage() { if (pdfDoc && pageNum < pdfDoc.numPages) { pageNum++; queueRenderPage(pageNum); } }

        prevBtn.addEventListener('click', onPrevPage);
        nextBtn.addEventListener('click', onNextPage);

        pdfjsLib.getDocument(pdfPath).promise.then(function(pdf) {
          pdfDoc = pdf;
          renderPage(pageNum);
        }).catch(function(error) {
          console.error('Error loading PDF:', error);
          pageInfo.textContent = 'Error loading PDF. Please try downloading it instead.';
        });

        container.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowLeft') onPrevPage();
          if (e.key === 'ArrowRight') onNextPage();
        });
        container.setAttribute('tabindex', '0');

        var resizeTimeout;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(function() {
            if (pdfDoc) queueRenderPage(pageNum);
          }, 250);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAllPDFViewers);
    } else {
      initAllPDFViewers();
    }
  })();
</script>

<style>
  .pdf-viewer-wrapper {
    width: 100%;
    max-width: 100%;
    margin: 2rem 0;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #f8fafc;
    box-sizing: border-box;
  }

  .pdf-canvas-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 400px;
    padding: 2rem;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .pdf-canvas {
    max-width: 100%;
    width: auto;
    height: auto;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    display: block;
    box-sizing: border-box;
  }

  .blog-content .pdf-controls,
  .pdf-controls {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 1rem !important;
    background: white;
    border-top: 1px solid var(--border-color);
    gap: 1rem;
    width: 100%;
    box-sizing: border-box;
    text-align: center;
    margin: 0 auto;
  }
  
  .blog-content .pdf-controls > *,
  .pdf-controls > * {
    flex: 0 0 auto !important;
    margin: 0 !important;
  }

  /* PDF button styles are in main.css */

  .pdf-page-info {
    color: var(--text-secondary);
    font-weight: 500;
    text-align: center;
    font-size: 1rem;
    margin: 0 0.5rem;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .pdf-viewer-wrapper {
      margin: 1rem 0;
      border-radius: 4px;
    }

    .pdf-canvas-container {
      padding: 1rem;
      min-height: 300px;
    }

    .pdf-canvas {
      max-width: 100%;
      width: auto;
      height: auto;
    }

    .pdf-controls {
      padding: 0.75rem;
      flex-wrap: nowrap;
      justify-content: center !important;
    }

    .pdf-nav-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }

    .pdf-page-info {
      font-size: 0.875rem;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .pdf-canvas-container {
      padding: 0.5rem;
      min-height: 250px;
    }

    .pdf-controls {
      padding: 0.5rem;
      gap: 0.5rem;
      justify-content: center !important;
    }

    .pdf-nav-btn {
      padding: 0.4rem 0.6rem;
      font-size: 0.8rem;
    }

    .pdf-page-info {
      font-size: 0.8rem;
    }
  }
</style>
